<?xml version="1.0" encoding="utf-8"?>
<!-- btn_outline.xml — Clean outline button with smooth press state -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#C8E6C9"/>
            <stroke android:width="2dp" android:color="#1B5E20"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#E8F5E9"/>
            <stroke android:width="2.5dp" android:color="#2E7D32"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8FFF8"/>
            <stroke android:width="2dp" android:color="#43A047"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</selector>
