<?xml version="1.0" encoding="utf-8"?>
<!-- btn_score.xml — Modern circular score button with glow effect -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#1B5E20"/>
            <stroke android:width="2.5dp" android:color="#81C784"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="0dp">
                <shape android:shape="oval">
                    <solid android:color="#1A2E7D32"/>
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:startColor="#4CAF50"
                        android:centerColor="#2E7D32"
                        android:endColor="#1B5E20"
                        android:angle="135"/>
                    <stroke android:width="1.5dp" android:color="#66BB6A"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
