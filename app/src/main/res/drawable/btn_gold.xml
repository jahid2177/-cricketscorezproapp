<?xml version="1.0" encoding="utf-8"?>
<!-- btn_gold.xml — Premium gold button for 4s and 6s -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#E65100"/>
            <stroke android:width="2dp" android:color="#FFCC02"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="0dp">
                <shape android:shape="oval">
                    <solid android:color="#1AFFA000"/>
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:startColor="#FFD740"
                        android:centerColor="#FFA000"
                        android:endColor="#E65100"
                        android:angle="135"/>
                    <stroke android:width="1.5dp" android:color="#FFCA28"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
