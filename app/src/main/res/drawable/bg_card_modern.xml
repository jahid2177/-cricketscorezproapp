<?xml version="1.0" encoding="utf-8"?>
<!-- bg_card_modern.xml — Elevated card with subtle shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow / shadow -->
    <item android:top="3dp" android:left="2dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#18000000"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Card surface -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="20dp"/>
            <stroke android:width="0.5dp" android:color="#E8F5E9"/>
        </shape>
    </item>
</layer-list>
