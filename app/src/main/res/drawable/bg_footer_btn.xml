<?xml version="1.0" encoding="utf-8"?>
<!-- bg_footer_btn.xml — Pill-shaped footer button with ripple feedback -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1A1B5E20">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="24dp"/>
            <stroke android:width="1dp" android:color="#E2E8F0"/>
        </shape>
    </item>
</ripple>
