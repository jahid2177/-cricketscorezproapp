<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Top App Bar / Header -->
    <LinearLayout
        android:layout_height="68dp"
        android:layout_width="match_parent"
        android:background="@drawable/bg_hero_header"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_height="40dp"
            android:layout_width="40dp"
            android:background="@drawable/bg_header_action_circle"
            android:clickable="true"
            android:focusable="true"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:text="Select Players"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:textSize="12sp"
                android:textColor="#D1FAE5"
                android:text="Set opening batsmen &amp; bowler" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:padding="16dp"
            android:orientation="vertical">

            <!-- 1. Batting Duo Card -->
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_modern"
                android:elevation="2dp"
                android:padding="18dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="14dp"
                        android:background="#16A34A"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#16A34A"
                        android:letterSpacing="0.08"
                        android:text="OPENING BATSMEN"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Striker -->
                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:text="Striker (On Strike)"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etStriker"
                    android:layout_height="48dp"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input_modern"
                    android:hint="Enter striker name"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:textColor="#0F172A"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:inputType="textCapWords" />

                <!-- Non-Striker -->
                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:text="Non-Striker (Runner)"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNonStriker"
                    android:layout_height="48dp"
                    android:layout_width="match_parent"
                    android:background="@drawable/bg_input_modern"
                    android:hint="Enter non-striker name"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:textColor="#0F172A"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:inputType="textCapWords" />

            </LinearLayout>

            <!-- 2. Opening Bowler Card -->
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_card_modern"
                android:elevation="2dp"
                android:padding="18dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="14dp"
                        android:background="#EA580C"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#EA580C"
                        android:letterSpacing="0.08"
                        android:text="OPENING BOWLER"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:text="Bowler Name"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBowler"
                    android:layout_height="48dp"
                    android:layout_width="match_parent"
                    android:background="@drawable/bg_input_modern"
                    android:hint="Enter opening bowler name"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:textColor="#0F172A"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:inputType="textCapWords" />

            </LinearLayout>

            <!-- Start Button -->
            <Button
                android:id="@+id/btnStartInnings"
                android:layout_height="54dp"
                android:layout_width="match_parent"
                android:background="@drawable/btn_primary"
                android:elevation="3dp"
                android:textSize="16sp"
                android:stateListAnimator="@null"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.03"
                android:text="Start Match →"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
