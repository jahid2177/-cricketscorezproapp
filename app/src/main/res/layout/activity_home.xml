<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_home.xml — Minimalist, Premium & Professional Stadium Dashboard
    Exactly matching the clean light-blue canvas, centered brand title,
    elevated rounded pill menu buttons, and bottom floating match card.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeRefreshHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dashboard_canvas"
        android:fitsSystemWindows="true">

        <ScrollView
            android:id="@+id/rootScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="90dp">

                <!-- Top action placeholders preserved for full code compatibility (completely hidden) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone">
                    <LinearLayout android:id="@+id/btnTheme" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"><TextView android:id="@+id/tvThemeIcon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" /></LinearLayout>
                    <LinearLayout android:id="@+id/btnAbout" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <LinearLayout android:id="@+id/btnShare" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <LinearLayout android:id="@+id/btnHeaderSettings" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <LinearLayout android:id="@+id/btnFavorites" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                </LinearLayout>

                <!-- ╔══════════════════════════════════════════════════╗ -->
                <!-- ║  2. CENTER BRAND TITLE & SUBTITLE                ║ -->
                <!-- ╚══════════════════════════════════════════════════╝ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="36dp">

                    <TextView
                        android:id="@+id/tvAppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cricket Scorez Pro"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#111827"
                        android:letterSpacing="0.01" />

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pull down to refresh match scores"
                        android:textSize="13sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- ╔══════════════════════════════════════════════════╗ -->
                <!-- ║  3. LIVE MATCH IN-PROGRESS (IF ACTIVE)           ║ -->
                <!-- ╚══════════════════════════════════════════════════╝ -->
                <LinearLayout
                    android:id="@+id/cardLiveMatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_menu_pill_button"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="14dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dot_red"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tvLiveBadge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="LIVE MATCH IN PROGRESS"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#DC2626"
                            android:letterSpacing="0.06" />

                        <TextView
                            android:id="@+id/btnResumeLiveMatch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resume ▶"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#2563EB" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLiveTeams"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Team 1 vs Team 2"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginTop="3dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:id="@+id/tvLiveScore"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="142/3 (14.2 ov)"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#059669" />

                        <TextView
                            android:id="@+id/tvLiveEquation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1st Innings"
                            android:textSize="12sp"
                            android:textColor="#64748B" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ╔══════════════════════════════════════════════════╗ -->
                <!-- ║  4. VERTICAL STACK OF 5 PILL MENU BUTTONS        ║ -->
                <!-- ╚══════════════════════════════════════════════════╝ -->

                <!-- 1. Start New Match -->
                <LinearLayout
                    android:id="@+id/btnStartNewMatch"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_menu_pill_button"
                    android:elevation="2.5dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tvTitleStartNewMatch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start New Match"
                        android:textSize="16.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#0F172A"
                        android:letterSpacing="0.01" />
                </LinearLayout>

                <!-- 2. Tournament -->
                <LinearLayout
                    android:id="@+id/btnTournament"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_menu_pill_button"
                    android:elevation="2.5dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tvTitleTournament"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tournament"
                        android:textSize="16.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#0F172A"
                        android:letterSpacing="0.01" />
                </LinearLayout>

                <!-- 3. Teams -->
                <LinearLayout
                    android:id="@+id/btnTeams"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_menu_pill_button"
                    android:elevation="2.5dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tvTitleTeams"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teams"
                        android:textSize="16.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#0F172A"
                        android:letterSpacing="0.01" />
                </LinearLayout>

                <!-- 4. Match History -->
                <LinearLayout
                    android:id="@+id/btnHistory"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_menu_pill_button"
                    android:elevation="2.5dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tvTitleHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Match History"
                        android:textSize="16.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#0F172A"
                        android:letterSpacing="0.01" />
                </LinearLayout>

                <!-- 5. Match Setting -->
                <LinearLayout
                    android:id="@+id/btnMatchSetting"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_menu_pill_button"
                    android:elevation="2.5dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tvTitleMatchSetting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Match Setting"
                        android:textSize="16.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#0F172A"
                        android:letterSpacing="0.01" />
                </LinearLayout>

                <!-- Hidden fallback views to maintain code safety -->
                <TextView android:id="@+id/tvHeroTag" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tvSubStartNewMatch" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tvSubTournament" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tvSubTeams" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tvSubHistory" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tvSubMatchSetting" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tvStatMatches" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tvStatTeams" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tvStatTournaments" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/chipTournament" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/chipRankings" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/chipFixtures" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/chipFavorites" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/chipSettings" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            </LinearLayout>

        </ScrollView>

        <!-- ╔══════════════════════════════════════════════════╗ -->
        <!-- ║  5. FLOATING BOTTOM MATCH CARD (AS IN PHOTO)     ║ -->
        <!-- ╚══════════════════════════════════════════════════╝ -->
        <LinearLayout
            android:id="@+id/cardRecentMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_bottom_match_card"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:elevation="4dp"
            android:visibility="gone">

            <!-- Left Cricket Icon Badge -->
            <LinearLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_icon_badge_green"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_clean_cricket"
                    android:contentDescription="Match" />
            </LinearLayout>

            <!-- Middle Text (Teams, Score, Status) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRecentTeams"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Team 1 vs Team 2"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#0F172A" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tvRecentScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10/0 (0.3 / 20 ov) • 11/0 (0.3 / 20 ov)"
                        android:textSize="11.5sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/tvRecentResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Team won!"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#059669"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRecentBadge"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Right Action: Share Match Result -->
            <LinearLayout
                android:id="@+id/btnRecentShare"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_circle_header_btn"
                android:elevation="1dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Share Match">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_clean_share"
                    android:contentDescription="Share Match" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
