<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_team_manager.xml
    Premium redesign — compact top bar, search pill, team list
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F0F4F8">

    <!-- ══ Premium Top Bar — 64dp, gradient ═══════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_hero_header"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <!-- Back -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"
            android:background="@drawable/bg_header_action_circle" />

        <!-- Title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:text="👥 Manage Teams"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:letterSpacing="0.01" />

        <!-- + New Team button -->
        <LinearLayout
            android:id="@+id/btnAddTeam"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_topbar_action_btn"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ New"
                android:textSize="12sp"
                android:textColor="#1B5E20"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- ══ Search bar ════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:background="#F0F4F8">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="🔍  Search teams..."
            android:textSize="14sp"
            android:textColor="#1E293B"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_search_pill"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

    </LinearLayout>

    <!-- ══ Empty state ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆"
            android:textSize="48sp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No teams yet"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='Tap "+ New" to create your first team'
            android:textSize="13sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- ══ Team list ═════════════════════════════════════════════════════ -->
    <ListView
        android:id="@+id/listViewTeams"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>
