<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_modern"
    android:padding="14dp"
    android:layout_marginBottom="6dp"
    android:layout_marginHorizontal="14dp"
    android:gravity="center_vertical"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvOverNumber"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:text="0.1"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:gravity="center"
        android:background="@drawable/bg_stat_pill"/>

    <View
        android:layout_width="1dp"
        android:layout_height="36dp"
        android:background="#E8F5E9"
        android:layout_marginHorizontal="12dp"/>

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Bowler to Batsman, no run."
        android:textSize="13sp"
        android:textColor="#424242"
        android:lineSpacingMultiplier="1.3"/>

    <TextView
        android:id="@+id/tvBallResult"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_pill_green"
        android:text="4"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginStart="10dp"/>

</LinearLayout>
