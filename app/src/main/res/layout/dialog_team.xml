<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_team.xml — Create / Edit Team dialog
    Premium: compact header, clear input, matched buttons
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_premium"
    android:clipToOutline="true">

    <!-- Green gradient header — compact 48dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dialog_header">

        <TextView
            android:id="@+id/tvDialogTeamTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Create New Team"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

    </LinearLayout>

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="6dp">

        <!-- Team Photo / Logo Picker Container -->
        <LinearLayout
            android:id="@+id/layoutDialogTeamPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <!-- Fallback Initial / Avatar Circle -->
                <TextView
                    android:id="@+id/tvDialogTeamInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:text="T"
                    android:background="@drawable/bg_avatar_circle" />

                <!-- Actual Team Image -->
                <ImageView
                    android:id="@+id/ivDialogTeamLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Small camera overlay pill -->
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom|end"
                    android:gravity="center"
                    android:text="📷"
                    android:textSize="12sp"
                    android:background="@drawable/bg_circle_white"
                    android:elevation="3dp" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvDialogPhotoHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to choose team logo"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#16A34A"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/btnDialogRemovePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗑️ Remove Logo"
                android:textSize="11sp"
                android:textColor="#DC2626"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TEAM NAME"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:letterSpacing="0.1"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/etDialogTeamName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_modern"
            android:hint="e.g. Dhaka Warriors"
            android:textColorHint="@color/textHint"
            android:textSize="15sp"
            android:textColor="@color/textPrimary"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:imeOptions="actionDone" />

    </LinearLayout>

    <!-- Thin separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEF2EE"
        android:layout_marginTop="14dp" />

    <!-- Button row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_btn_cancel"
            android:text="Cancel"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnDialogSave"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_save"
            android:text="Save"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>
