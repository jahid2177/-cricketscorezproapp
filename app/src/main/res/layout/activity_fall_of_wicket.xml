<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/colorPrimary"
            android:paddingHorizontal="15dp">

            <ImageView
                android:id="@+id/btnBackWicket"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/white"
                android:layout_centerVertical="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fall of wicket"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_centerInParent="true"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Extra Ball Notice (Shown dynamically for No-Ball / Wide / Bye / Leg-Bye) -->
            <LinearLayout
                android:id="@+id/layoutExtraNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_modern"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvExtraNoticeIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️"
                    android:textSize="18sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvExtraNoticeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No-Ball Delivery: Only Run Out is valid"
                    android:textColor="#C2410C"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How wicket fall? (Dismissal Type)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp"/>
            <Spinner
                android:id="@+id/spWicketType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_card"
                android:padding="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- Completed Runs Section (Crucial for Run Out) -->
            <LinearLayout
                android:id="@+id/layoutCompletedRuns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_modern"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏃 Completed Runs Before Wicket"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Runs completed before dismissal (e.g. 1 run ran then run out):"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnRun0"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="0"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_green_rect"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnRun1"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="1"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:background="@drawable/bg_card"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnRun2"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:background="@drawable/bg_card"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnRun3"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="3"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:background="@drawable/bg_card"
                        android:layout_marginEnd="6dp" />

                    <EditText
                        android:id="@+id/etCompletedRuns"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:inputType="number"
                        android:text="0"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:background="@drawable/bg_card" />

                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Who got out?"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp"/>
            <Spinner
                android:id="@+id/spWhoGotOut"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_card"
                android:padding="8dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Who helped? (Fielder / Catcher)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/etWhoHelped"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Fielder Name (Optional)"
                android:textSize="15sp"
                android:padding="10dp"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Batsman Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/etNewBatsman"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter incoming batsman name"
                android:textSize="15sp"
                android:padding="10dp"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="16dp"/>

            <!-- Next Strike Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next Batter on Strike (*)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp"/>
            <Spinner
                android:id="@+id/spNextStriker"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_card"
                android:padding="8dp"
                android:layout_marginBottom="26dp"/>

            <Button
                android:id="@+id/btnDoneWicket"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="✓ Confirm Fall of Wicket"
                android:background="@drawable/bg_green_rect"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>

