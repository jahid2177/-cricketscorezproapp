<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="#F0F4F0"
     android:orientation="vertical">

    <RelativeLayout
         android:layout_height="210dp"
         android:layout_width="match_parent"
         android:background="@drawable/bg_hero_header"
         android:padding="20dp">

        <ImageView
             android:layout_height="32dp"
             android:layout_width="32dp"
             android:src="@android:drawable/ic_menu_revert"
             android:padding="4dp"
             android:tint="#FFFFFF"
             android:id="@+id/btnBackProfile" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:layout_centerInParent="true"
             android:gravity="center"
             android:orientation="vertical">

            <FrameLayout
                 android:layout_height="96dp"
                 android:layout_width="96dp"
                 android:layout_marginBottom="10dp"
                 android:id="@+id/layoutPhotoContainer"
                 android:clickable="true"
                 android:focusable="true">

                <View
                     android:layout_height="96dp"
                     android:layout_width="96dp"
                     android:background="@drawable/bg_logo_circle"
                     android:alpha="0.2" />

                <!-- Fallback Initial / Icon -->
                <TextView
                     android:layout_height="80dp"
                     android:layout_width="80dp"
                     android:layout_gravity="center"
                     android:gravity="center"
                     android:textSize="32sp"
                     android:textStyle="bold"
                     android:textColor="#FFFFFF"
                     android:background="@drawable/bg_avatar_circle"
                     android:id="@+id/tvProfileInitial"
                     android:text="P" />

                <!-- Uploaded Profile Image -->
                <ImageView
                     android:layout_height="80dp"
                     android:layout_width="80dp"
                     android:scaleType="centerCrop"
                     android:layout_gravity="center"
                     android:visibility="gone"
                     android:id="@+id/ivPlayerProfileImage" />

                <!-- Camera Badge Overlay -->
                <FrameLayout
                     android:layout_height="28dp"
                     android:layout_width="28dp"
                     android:layout_gravity="bottom|end"
                     android:background="@drawable/bg_action_edit"
                     android:elevation="4dp"
                     android:id="@+id/btnCameraBadge">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:layout_gravity="center"
                         android:text="📷"
                         android:textSize="14sp" />
                </FrameLayout>

            </FrameLayout>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="22sp"
                 android:textColor="#FFFFFF"
                 android:letterSpacing="0.02"
                 android:id="@+id/tvProfileName"
                 android:text="Player Name"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="13sp"
                 android:textColor="#B9F6CA"
                 android:layout_marginTop="4dp"
                 android:id="@+id/tvProfileRole"
                 android:text="Batsman" />

        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
         android:layout_height="52dp"
         android:layout_width="match_parent"
         android:background="#FFFFFF"
         android:elevation="4dp">

        <Button
             android:layout_height="match_parent"
             android:layout_width="0dp"
             android:background="@drawable/btn_primary"
             android:textSize="12sp"
             android:stateListAnimator="@null"
             android:textColor="#FFFFFF"
             android:letterSpacing="0.06"
             android:layout_weight="1"
             android:id="@+id/tabBatting"
             android:text="BATTING"
             android:textStyle="bold" />

        <Button
             android:layout_height="match_parent"
             android:layout_width="0dp"
             android:background="@android:color/transparent"
             android:textSize="12sp"
             android:stateListAnimator="@null"
             android:textColor="#2E7D32"
             android:letterSpacing="0.06"
             android:layout_weight="1"
             android:id="@+id/tabBowling"
             android:text="BOWLING"
             android:textStyle="bold" />

        <Button
             android:layout_height="match_parent"
             android:layout_width="0dp"
             android:background="@android:color/transparent"
             android:textSize="12sp"
             android:stateListAnimator="@null"
             android:textColor="#2E7D32"
             android:letterSpacing="0.06"
             android:layout_weight="1"
             android:id="@+id/tabFielding"
             android:text="FIELDING"
             android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:padding="14dp"
         android:overScrollMode="never">

        <GridLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:columnOrderPreserved="false"
             android:alignmentMode="alignMargins"
             android:id="@+id/gridStats"
             android:columnCount="2">

        </GridLayout>

    </ScrollView>

</LinearLayout>