<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="#F0F7F0"
     android:orientation="vertical">

    <RelativeLayout
         android:layout_height="72dp"
         android:layout_width="match_parent"
         android:background="@drawable/bg_hero_header"
         android:elevation="6dp"
         android:paddingHorizontal="16dp">

        <ImageView
             android:layout_height="36dp"
             android:layout_width="36dp"
             android:src="@android:drawable/ic_menu_revert"
             android:background="?android:attr/selectableItemBackgroundBorderless"
             android:layout_centerVertical="true"
             android:padding="6dp"
             android:tint="#FFFFFF"
             android:id="@+id/btnBack" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:layout_centerInParent="true"
             android:textSize="19sp"
             android:textColor="#FFFFFF"
             android:text="⭐ Player Rankings"
             android:textStyle="bold" />

    </RelativeLayout>

    <LinearLayout
         android:layout_height="56dp"
         android:layout_width="match_parent"
         android:background="#FFFFFF"
         android:gravity="center"
         android:elevation="3dp"
         android:paddingVertical="8dp"
         android:orientation="horizontal"
         android:paddingHorizontal="20dp">

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="0dp"
             android:layout_marginEnd="6dp"
             android:gravity="center"
             android:clickable="true"
             android:orientation="horizontal"
             android:layout_weight="1"
             android:focusable="true"
             android:id="@+id/tabBat">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="14sp"
                 android:tag="label"
                 android:text="🏏  Batsmen"
                 android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="0dp"
             android:gravity="center"
             android:clickable="true"
             android:orientation="horizontal"
             android:layout_marginStart="6dp"
             android:layout_weight="1"
             android:focusable="true"
             android:id="@+id/tabBowl">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="14sp"
                 android:tag="label"
                 android:text="⚾  Bowlers"
                 android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:padding="16dp"
         android:clipToPadding="false">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="vertical">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="16dp"
                 android:background="@drawable/bg_card_modern"
                 android:elevation="3dp"
                 android:orientation="vertical"
                 android:id="@+id/containerTopBatsmen">

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="16dp"
                 android:background="@drawable/bg_card_modern"
                 android:elevation="3dp"
                 android:orientation="vertical"
                 android:id="@+id/containerTopBowlers">

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>