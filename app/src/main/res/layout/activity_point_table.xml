<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F0F4F8">

    <!-- ══ Premium Top Bar ══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_hero_header"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_header_action_circle"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:contentDescription="Back" />

        <!-- Title: Takes remaining space cleanly without overlap -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:text="📊 Point Table"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Action Buttons — right-aligned, same height, perfectly vertically centered -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnEditManual"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:paddingHorizontal="10dp"
                android:background="@drawable/bg_btn_gold"
                android:text="Manual"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <Button
                android:id="@+id/btnPdf"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:paddingHorizontal="10dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_white_green"
                android:text="PDF"
                android:textColor="#1B5E20"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

    <!-- ══ Body ═════════════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp" />

    </ScrollView>

</LinearLayout>
