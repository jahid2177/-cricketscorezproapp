<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_premium"
    android:padding="20dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill_neutral"
        android:layout_marginBottom="16dp" />

    <!-- Header: Teams + Live Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_cricket_ball_globe"
            app:tint="#16A34A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tvSheetMatchTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Team 1 vs Team 2"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tvSheetVenueInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Match • T20 Format"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSheetLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_pill_green"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginVertical="14dp" />

    <!-- Current Score High-Contrast Summary Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_viewer_hero_blue"
        android:padding="16dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSheetBattingTeam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Batting: Team 1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#BAE6FD" />

            <TextView
                android:id="@+id/tvSheetInningsTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Innings 1"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_role_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvSheetScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvSheetOvers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" (0.0 Ov)"
                android:textSize="16sp"
                android:textColor="#BAE6FD"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp" />
        </LinearLayout>

        <!-- Rate Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvSheetCRR"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CRR: 0.00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvSheetRRR"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RRR: -"
                android:textSize="12sp"
                android:textColor="#FDE047"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvSheetTarget"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Target: -"
                android:textSize="12sp"
                android:textColor="#BAE6FD"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Detailed Stats Container (Scrollable if needed) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Active Batter Performance -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏏 ON-FIELD BATTERS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_viewer_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvSheetStriker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Striker: -"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/tvSheetStrikerStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 (0b, 0x4, 0x6) SR 0.0"
                    android:textSize="12sp"
                    android:textColor="#334155" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginVertical="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvSheetNonStriker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Non-Striker: -"
                    android:textSize="13sp"
                    android:textColor="#334155" />

                <TextView
                    android:id="@+id/tvSheetNonStrikerStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 (0b, 0x4, 0x6) SR 0.0"
                    android:textSize="12sp"
                    android:textColor="#334155" />
            </LinearLayout>
        </LinearLayout>

        <!-- Active Bowler Performance -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 CURRENT BOWLER"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_viewer_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvSheetBowler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bowler: -"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tvSheetBowlerStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0-0-0-0 (Econ 0.0)"
                android:textSize="12sp"
                android:textColor="#334155" />
        </LinearLayout>

        <!-- Match Equation & Extras -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_white"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PARTNERSHIP"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/tvSheetPartnership"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 runs (0 balls)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXTRAS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/tvSheetExtras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 (wd 0, nb 0, b 0, lb 0)"
                    android:textSize="12sp"
                    android:textColor="#0F172A"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Button: View Full Scorecard -->
        <Button
            android:id="@+id/btnSheetFullScorecard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📊 View Detailed Scorecard"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary"
            android:elevation="2dp" />

    </LinearLayout>
</LinearLayout>
