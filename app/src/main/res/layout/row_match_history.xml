<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_modern"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="14dp"
    android:elevation="3dp">

    <TextView
        android:id="@+id/tvMatchDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="18/12/2025 - 08:43 AM"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#9E9E9E"
        android:letterSpacing="0.04"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvTeam1Icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_green"
            android:text="A"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvTeam1Name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Team A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1B1B1B"
            android:layout_marginStart="10dp"/>

        <TextView
            android:id="@+id/tvTeam1Score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0 (0.0)"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvTeam2Icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_orange_modern"
            android:text="B"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvTeam2Name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Team B"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1B1B1B"
            android:layout_marginStart="10dp"/>

        <TextView
            android:id="@+id/tvTeam2Score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yet to bat"
            android:textStyle="bold"
            android:textColor="#757575"
            android:textSize="14sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvMatchStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="In Progress"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:background="@drawable/bg_stat_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:layout_marginBottom="10dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnScoreboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 Scoreboard"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"/>

        <TextView
            android:id="@+id/btnResume"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="▶  Resume"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary"/>

        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#BDBDBD"
            android:layout_marginStart="10dp"
            android:padding="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>
</LinearLayout>
