<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_add_player.xml — Add / Edit Player dialog
    Premium: compact header, clear field, role chips with visible selected state
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_premium"
    android:clipToOutline="true">

    <!-- Header — 50dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dialog_header">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Player"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Scrollable body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="4dp">

            <!-- Player name field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLAYER NAME"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:letterSpacing="0.1"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etPlayerName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_modern"
                android:hint="e.g. Shakib Al Hasan"
                android:textColorHint="@color/textHint"
                android:textSize="15sp"
                android:textColor="@color/textPrimary"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:layout_marginBottom="18dp" />

            <!-- Role section label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT ROLES"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp" />

            <!-- Row 1: Batsman | Bowler -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <CheckBox
                    android:id="@+id/cbBatsman"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="🏏  Batsman"
                    android:textSize="13sp"
                    android:textColor="@color/textPrimary"
                    android:paddingStart="12dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_role_chip"
                    android:button="@android:color/transparent" />

                <CheckBox
                    android:id="@+id/cbBowler"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="⚡  Bowler"
                    android:textSize="13sp"
                    android:textColor="@color/textPrimary"
                    android:paddingStart="12dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_role_chip"
                    android:button="@android:color/transparent" />

            </LinearLayout>

            <!-- Row 2: All-Rounder | WK -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <CheckBox
                    android:id="@+id/cbAllRounder"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="🌟  All-Rounder"
                    android:textSize="13sp"
                    android:textColor="@color/textPrimary"
                    android:paddingStart="12dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_role_chip"
                    android:button="@android:color/transparent" />

                <CheckBox
                    android:id="@+id/cbWicketKeeper"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="🧤  WK"
                    android:textSize="13sp"
                    android:textColor="@color/textPrimary"
                    android:paddingStart="12dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_role_chip"
                    android:button="@android:color/transparent" />

            </LinearLayout>

            <!-- Row 3: Captain — full width -->
            <CheckBox
                android:id="@+id/cbCaptain"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
                android:text="⭐  Captain"
                android:textSize="13sp"
                android:textColor="@color/textPrimary"
                android:paddingStart="12dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_role_chip"
                android:button="@android:color/transparent" />

        </LinearLayout>

    </ScrollView>

    <!-- Thin separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEF2EE"
        android:layout_marginTop="8dp" />

    <!-- Button row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_btn_cancel"
            android:text="Cancel"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnDialogSave"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_save"
            android:text="Save"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>
