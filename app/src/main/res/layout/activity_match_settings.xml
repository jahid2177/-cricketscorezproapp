<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:paddingBottom="36dp">

        <!-- Top App Bar / Header -->
        <LinearLayout
            android:layout_height="68dp"
            android:layout_width="match_parent"
            android:background="@drawable/bg_hero_header"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_height="40dp"
                android:layout_width="40dp"
                android:background="@drawable/bg_header_action_circle"
                android:clickable="true"
                android:focusable="true"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:text="New Match Setup"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#D1FAE5"
                    android:text="Configure teams, toss &amp; overs" />

            </LinearLayout>

        </LinearLayout>

        <!-- 1. Teams Card -->
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:background="@drawable/bg_card_modern"
            android:elevation="2dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:padding="18dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="14dp"
                    android:background="#16A34A"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#16A34A"
                    android:letterSpacing="0.08"
                    android:text="TEAMS"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Team 1 -->
                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:textSize="12sp"
                        android:textColor="#64748B"
                        android:text="Team 1 (Host)"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etTeam1"
                        android:layout_height="48dp"
                        android:layout_width="match_parent"
                        android:background="@drawable/bg_input_modern"
                        android:hint="e.g. Tigers"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp"
                        android:textColor="#0F172A"
                        android:paddingHorizontal="14dp"
                        android:maxLines="1"
                        android:inputType="textCapWords" />

                </LinearLayout>

                <!-- VS Badge -->
                <TextView
                    android:layout_height="32dp"
                    android:layout_width="32dp"
                    android:gravity="center"
                    android:background="@drawable/bg_vs_badge"
                    android:textSize="11sp"
                    android:textColor="#15803D"
                    android:text="VS"
                    android:textStyle="bold"
                    android:layout_marginHorizontal="8dp" />

                <!-- Team 2 -->
                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:textSize="12sp"
                        android:textColor="#64748B"
                        android:text="Team 2 (Visitor)"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etTeam2"
                        android:layout_height="48dp"
                        android:layout_width="match_parent"
                        android:background="@drawable/bg_input_modern"
                        android:hint="e.g. Lions"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp"
                        android:textColor="#0F172A"
                        android:paddingHorizontal="14dp"
                        android:maxLines="1"
                        android:inputType="textCapWords" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 2. Toss Card -->
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:background="@drawable/bg_card_modern"
            android:elevation="2dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:padding="18dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="14dp"
                    android:background="#16A34A"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#16A34A"
                    android:letterSpacing="0.08"
                    android:text="TOSS"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_marginBottom="8dp"
                android:textSize="13sp"
                android:textColor="#334155"
                android:text="Who won the toss?"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTossWinner"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_modern"
                android:paddingVertical="6dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <RadioButton
                    android:id="@+id/rbTeam1"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:checked="true"
                    android:layout_weight="1"
                    android:text="Team 1" />

                <RadioButton
                    android:id="@+id/rbTeam2"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:layout_weight="1"
                    android:text="Team 2" />

            </RadioGroup>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_marginBottom="8dp"
                android:textSize="13sp"
                android:textColor="#334155"
                android:text="Toss Decision"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTossDecision"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:background="@drawable/bg_input_modern"
                android:paddingVertical="6dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <RadioButton
                    android:id="@+id/rbBatting"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:checked="true"
                    android:layout_weight="1"
                    android:text="Batting" />

                <RadioButton
                    android:id="@+id/rbBowling"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:layout_weight="1"
                    android:text="Bowling" />

            </RadioGroup>

        </LinearLayout>

        <!-- 3. Match Format Card -->
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:background="@drawable/bg_card_modern"
            android:elevation="2dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:padding="18dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="14dp"
                    android:background="#16A34A"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#16A34A"
                    android:letterSpacing="0.08"
                    android:text="MATCH FORMAT"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_marginBottom="8dp"
                android:textSize="13sp"
                android:textColor="#334155"
                android:text="Total Overs"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOvers"
                android:layout_height="48dp"
                android:layout_width="match_parent"
                android:background="@drawable/bg_input_modern"
                android:hint="e.g. 20"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:textColor="#0F172A"
                android:paddingHorizontal="14dp"
                android:maxLines="1"
                android:inputType="number" />

        </LinearLayout>

        <!-- Start Match Button -->
        <Button
            android:id="@+id/btnStartMatch"
            android:layout_height="54dp"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_primary"
            android:elevation="3dp"
            android:textSize="16sp"
            android:stateListAnimator="@null"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.03"
            android:text="Start Match →"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBack"
            android:layout_height="44dp"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="16dp"
            android:background="@android:color/transparent"
            android:textSize="13sp"
            android:stateListAnimator="@null"
            android:textColor="#64748B"
            android:text="← Cancel &amp; Go Back" />

    </LinearLayout>

</ScrollView>
