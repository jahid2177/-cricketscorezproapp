<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnTournamentsBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#1E293B"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tournaments"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Subtabs Bar (Fixtures | Points | Result | Awards) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="1dp">

        <!-- Subtab: Fixtures -->
        <LinearLayout
            android:id="@+id/subtabFixtures"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvSubtabFixtures"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Fixtures"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#16A34A" />

            <View
                android:id="@+id/lineSubtabFixtures"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="#16A34A" />
        </LinearLayout>

        <!-- Subtab: Points -->
        <LinearLayout
            android:id="@+id/subtabPoints"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvSubtabPoints"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Points"
                android:textSize="13sp"
                android:textColor="#64748B" />

            <View
                android:id="@+id/lineSubtabPoints"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:visibility="invisible"
                android:background="#16A34A" />
        </LinearLayout>

        <!-- Subtab: Result -->
        <LinearLayout
            android:id="@+id/subtabResult"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvSubtabResult"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Result"
                android:textSize="13sp"
                android:textColor="#64748B" />

            <View
                android:id="@+id/lineSubtabResult"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:visibility="invisible"
                android:background="#16A34A" />
        </LinearLayout>

        <!-- Subtab: Awards -->
        <LinearLayout
            android:id="@+id/subtabAwards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvSubtabAwards"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Awards"
                android:textSize="13sp"
                android:textColor="#64748B" />

            <View
                android:id="@+id/lineSubtabAwards"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:visibility="invisible"
                android:background="#16A34A" />
        </LinearLayout>

    </LinearLayout>

    <!-- Scrollable container for selected tournament subtab -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:id="@+id/tournamentContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp" />

    </ScrollView>

</LinearLayout>
